{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build raylib",
      "type": "process",
      "command": "/bin/bash",
      "args": [
        "${workspaceFolder}/build.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Run raylib",
      "type": "process",
      "command": "${workspaceFolder}/build/raylib-starter",
      "dependsOn": "Build raylib",
      "problemMatcher": []
    }
  ]
}
